---
import SocialLinks from "./SocialLinks.astro";
import SupportTheProject from "./SupportTheProject.astro";
import { PRODUCT_LINKS, RESOURCE_LINKS, COMPANY_LINKS } from "../data/navigation";

const today = new Date();

const columns = [
  { title: "Products", links: PRODUCT_LINKS },
  { title: "Resources", links: RESOURCE_LINKS },
  { title: "Company", links: COMPANY_LINKS },
];
---

<footer class="border-t border-white/5 mt-20">
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-8">
    <div class="grid grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-12">

      <!-- Brand Column -->
      <div class="col-span-2">
        <a href="/">
          <img src="/images/logos/logo-light.png" alt="Colyseus" class="h-8 mb-4" />
        </a>
        <p class="text-gray-500 text-sm leading-relaxed max-w-xs">
          The developer-friendly framework for real-time multiplayer games.
        </p>
        <SocialLinks class="flex gap-4 mt-6" />
      </div>

      {columns.map((column) => (
        <div>
          <h3 class="text-white text-sm font-semibold mb-4">{column.title}</h3>
          <ul class="space-y-3 text-sm text-gray-500">
            {column.links.map((link) => (
              <li><a href={link.href} class="hover:text-gray-300 transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2 lg:col-span-1">
        <SupportTheProject />
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-white/5 text-center lg:text-left">
      <p class="text-gray-600 text-sm">&copy; {today.getFullYear()} Endel Dreyer. All rights reserved.</p>
    </div>
  </div>
</footer>
