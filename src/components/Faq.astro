---
/**
 * Accordion FAQ that also emits FAQPage JSON-LD from the same list.
 * Answers are plain text; wrap inline code in backticks.
 */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  heading: string;
  eyebrow?: string;
  accent?: "purple" | "blue";
  id?: string;
}

const { items, heading, eyebrow = "FAQ", accent = "purple", id = "faq" } = Astro.props;

// Full class names, so Tailwind keeps them.
const tones = {
  purple: { eyebrow: "text-purple-400", hover: "hover:text-purple-200", code: "text-purple-300" },
  blue: { eyebrow: "text-blue-400", hover: "hover:text-blue-200", code: "text-blue-300" },
}[accent];

const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const toHtml = (s: string) => escape(s).replace(/`([^`]+)`/g, `<code class="font-mono text-[0.9em] px-1.5 py-0.5 rounded bg-white/5 ${tones.code}">$1</code>`);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/`/g, "") },
  })),
};
---

<section id={id} class="border-t border-white/5 scroll-mt-16">
  <div class="max-w-3xl mx-auto px-6 py-20 lg:py-28">
    <div class="text-center mb-10" data-reveal>
      <p class={`text-sm font-medium ${tones.eyebrow} uppercase tracking-widest mb-4`}>{eyebrow}</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-white">{heading}</h2>
    </div>
    <div class="divide-y divide-white/5 rounded-2xl border border-white/5 bg-white/[0.02]">
      {items.map((f, i) => (
        <details class="faq-item group" data-reveal style={`--reveal-delay:${0.04 * i}s`}>
          <summary class={`flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 text-white font-medium ${tones.hover} transition-colors`}>
            <span>{f.q}</span>
            <svg class="w-4 h-4 shrink-0 text-gray-500 transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </summary>
          <div class="faq-body">
            <div class="overflow-hidden">
              <p class="px-5 pb-5 text-gray-400 leading-relaxed" set:html={toHtml(f.a)} />
            </div>
          </div>
        </details>
      ))}
    </div>
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  /* The grid-rows trick animates height to auto; `interpolate-size` isn't widely supported yet. */
  .faq-body { display: grid; grid-template-rows: 1fr; }
  @media (prefers-reduced-motion: no-preference) {
    .faq-item .faq-body { transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  }
  .faq-item.is-closing .faq-body { grid-template-rows: 0fr; }
  .faq-item.is-opening .faq-body { grid-template-rows: 0fr; }
</style>

<script>
  // <details> toggles instantly; hold it open while the body collapses, then close it.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((item) => {
      item.querySelector("summary")!.addEventListener("click", (e) => {
        e.preventDefault();
        if (item.open) {
          item.classList.add("is-closing");
          setTimeout(() => { item.open = false; item.classList.remove("is-closing"); }, 320);
        } else {
          item.classList.add("is-opening");
          item.open = true;
          requestAnimationFrame(() => requestAnimationFrame(() => item.classList.remove("is-opening")));
        }
      });
    });
  }
</script>
