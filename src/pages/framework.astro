---
import { Image } from "astro:assets";
import { Code } from "astro-expressive-code/components";

import MainLayout from "../layouts/MainLayout.astro";
import Aurora from "../components/Aurora.astro";
import Platforms from "../components/Platforms.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import SponsorsSection from "../components/SponsorsSection.astro";
import ScrollCodeShowcase from "../components/ScrollCodeShowcase.astro";
import SDKShowcase from "../components/SDKShowcase.astro";
import SyncDemo from "../components/framework/SyncDemo.astro";
import ScaleDiagram from "../components/framework/ScaleDiagram.astro";
import { githubStars } from "../indexes/stats";
import { SOCIAL_LINKS } from "../data/navigation";
import { SUPPORTERS_ENTRY_URL } from "../data/supporters";

import logoDiscordjs from "../../assets/framework/logo-discordjs.png";
import logoPlayfab from "../../assets/framework/logo-playfab.png";
import logoFirebase from "../../assets/framework/logo-firebase.png";
import logoMongodb from "../../assets/framework/logo-mongodb.png";
import logoPostgres from "../../assets/framework/logo-postgres.png";

const CREATE_COMMAND = "npm create colyseus-app@latest ./my-server";
const DOCS_URL = "https://docs.colyseus.io/getting-started";
const GITHUB_URL = "https://github.com/colyseus/colyseus";
const discordUrl = SOCIAL_LINKS.find((l) => l.label === "Discord")!.href;
// The GitHub API can rate-limit the build; drop the count rather than show "NaN".
const stars = typeof githubStars === "number" ? `${(githubStars / 1000).toFixed(1)}k` : null;

const highlights = [
  { label: "Cheat-proof by design", icon: `<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/>` },
  { label: "Built-in matchmaking", icon: `<path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/>` },
  { label: "Real-time sync that just works", icon: `<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/>` },
  { label: "Client-side prediction built in", icon: `<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>` },
  { label: "Scale from 10 to 10,000+ CCU", icon: `<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/>` },
  { label: "Self-host or use Colyseus Cloud", icon: `<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4.6 12.5 3.5 3.5 0 0 0 6.5 19z"/>` },
  { label: "Use tools you already know", icon: `<path d="m21 8-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>` },
  { label: "Free forever (MIT License)", icon: `<path d="M12 21s-7-4.4-9.3-9A5 5 0 0 1 12 6a5 5 0 0 1 9.3 6c-2.3 4.6-9.3 9-9.3 9z"/>` },
];

// Trimmed from the 0.18 announcement; applyInput() is the user's shared step function.
const netcodeServer = `import { Room } from "colyseus";
// Shared with the client, which runs the same step.
import { applyInput } from "./shared/applyInput";

export class GameRoom extends Room {
  state = new GameState();

  // Buffered per client; hacked values are clamped on arrival.
  inputs = this.defineInput(MoveInput, {
    sanitize: { moveX: (v) => Math.max(-1, Math.min(1, v)) },
  });

  // Remembers past positions for lag-compensated hits.
  rewind = this.allowRewindState({ maxRewindMs: 500 });

  onCreate() {
    this.rewind.attachAll(this.state.players, { fields: ["x", "y"] });
    this.setFixedTimestep((ctx) => this.step(ctx), 30);
  }

  step(ctx) {
    for (const [sid, p] of this.state.players) {
      const cmd = this.inputs.get(sid).next();
      if (cmd) applyInput(p, cmd, ctx.dt);
    }
  }
}`;

const netcodeClient = `import { Predict } from "@colyseus/sdk";
// The same function the server runs.
import { applyInput } from "./shared/applyInput";

const predict = Predict.get(room, { mode: "lerp", delay: 100 });

// Everyone else: interpolated 100ms in the past.
predict.attachAll("players", { mode: "lerp", fields: ["x", "y"] });

// You: predicted now, reconciled when the server answers.
const input = room.input({ type: MoveInput });
const me = predict.reconciler(room.state.players.get(room.sessionId), {
  input,
  step: (ctx, s, cmd) => applyInput(s, cmd, ctx.dt),
});`;

const netcodePoints = [
  {
    title: "Client-side prediction",
    body: "Your player moves on the next frame. When the server's state arrives, the reconciler rewinds, replays the inputs it hasn't acknowledged and smooths out the difference.",
    icon: `<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>`,
  },
  {
    title: "Lag compensation",
    body: "Hit tests see the world as each shooter saw it, so a shot fired at 250 ms of latency still lands.",
    icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>`,
  },
  {
    title: "Smooth remote players",
    body: "Everyone else renders a short delay behind, interpolated between snapshots, so they move smoothly.",
    icon: `<path d="M3 17c3-8 6-8 9 0s6 8 9 0"/>`,
  },
  {
    title: "Fixed timestep, validated input",
    body: "Your simulation steps at a constant rate. Inputs are buffered per client, and hacked values are clamped before your code reads them.",
    icon: `<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/>`,
  },
];

const stack = [
  {
    title: "Node.js runtime",
    body: "Asynchronous, event-driven JavaScript runtime, designed to build scalable network applications.",
    href: "https://nodejs.org/en/about",
    icon: `<path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M12 22V12M3 7l9 5 9-5"/>`,
  },
  {
    title: "Networking transport",
    body: "WebSockets by default. Swap in uWebSockets.js, Bun, or the experimental WebTransport.",
    href: "https://docs.colyseus.io/server/transport",
    icon: `<path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,
  },
  {
    title: "Room-based system",
    body: "Stateful rooms spawn on demand, one per match, each with its own state, logic and clients.",
    href: "https://docs.colyseus.io/room",
    icon: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>`,
  },
  {
    title: "Message serialization",
    body: "Binary delta encoding for state, about 2.4× faster in Schema 5.0, and the fastest MessagePack serializer for everything else.",
    href: "https://docs.colyseus.io/state/schema",
    icon: `<path d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
  },
  {
    title: "HTTP routes",
    body: "Define your own API routes with Express or better-call, next to your rooms.",
    href: "https://docs.colyseus.io/server/http-routes",
    icon: `<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>`,
  },
  {
    title: "Database & auth",
    body: "Persist players, cloud saves and leaderboards with @colyseus/database, or bring the database and auth provider you already use.",
    href: "https://docs.colyseus.io/database",
    icon: `<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>`,
  },
];

const scaling = [
  "Distribute rooms across servers and/or processes",
  "Allow cluster-wide match-making",
  "Leverage all your available CPUs",
  "Connect clients <strong class=\"text-white\">directly</strong> to their requested rooms",
  "Stateful processes keep track of their own rooms",
];

const tools = [
  {
    title: "Playground",
    body: "Open client connections from the browser and inspect every message exchanged with the server.",
    href: "https://docs.colyseus.io/tools/playground",
    icon: `<path d="M5 3l14 9-14 9V3z"/>`,
  },
  {
    title: "Monitoring panel",
    body: "List the rooms your server spawned, inspect their state and manage connected clients.",
    href: "https://docs.colyseus.io/tools/monitoring",
    icon: `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`,
  },
  {
    title: "Room debug panel",
    body: "Inspect state and messages in your game's page, and simulate high latency or dropped connections.",
    href: "https://docs.colyseus.io/getting-started/typescript#room-debug-panel",
    icon: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14l2 2-2 2M13 18h3"/>`,
  },
  {
    title: "Admin panel",
    badge: "Beta",
    body: "A production console for users, database tables, live rooms, dashboards and an audit trail.",
    href: "https://docs.colyseus.io/admin",
    icon: `<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>`,
  },
  {
    title: "Unit testing",
    body: "Utilities for testing your rooms with your favorite test framework.",
    href: "https://docs.colyseus.io/tools/unit-testing",
    icon: `<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>`,
  },
  {
    title: "Load testing",
    body: "Simulate concurrent client connections and see how your server behaves under traffic.",
    href: "https://docs.colyseus.io/tools/loadtest",
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
  },
];

const ecosystem = [
  { name: "PostgreSQL", logo: logoPostgres, href: "https://www.npmjs.com/package/pg" },
  { name: "MongoDB", logo: logoMongodb, href: "https://www.npmjs.com/package/mongodb" },
  { name: "Discord.js", logo: logoDiscordjs, href: "https://www.npmjs.com/package/discord.js" },
  { name: "Firebase", logo: logoFirebase, href: "https://www.npmjs.com/package/firebase-admin" },
  { name: "PlayFab", logo: logoPlayfab, href: "https://www.npmjs.com/package/playfab-sdk" },
];

const arrow = `<path d="M5 12h14M12 5l7 7-7 7"/>`;
const check = `<path d="M20 6 9 17l-5-5"/>`;
---

<MainLayout
  title="The Multiplayer Framework Developers Love"
  description="Open-source multiplayer framework for Node.js: matchmaking, delta state sync, client-side prediction, and SDKs for Unity, Godot, Defold, GameMaker and the web."
  isHeaderExpanded={false}
  isBlue={false}
>
  <ScrollReveal />

  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden">
    <Aurora tone="framework" grid />
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#0a0a0b] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-16 lg:pt-36 lg:pb-24">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14 lg:items-center">
        <div class="text-center lg:text-left">
          <a href="/blog/colyseus-0.18-is-here/" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-400/30 bg-purple-400/10 text-purple-200 text-sm font-medium hover:bg-purple-400/20 hover:border-purple-400/40 transition-all mb-6 animate-fade-up" data-track="framework_cta" data-track-target="release" data-track-placement="hero_badge">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-300"></span>
            <span class="sm:hidden">New: Colyseus 0.18</span>
            <span class="hidden sm:inline">New in 0.18: client-side prediction &amp; lag compensation</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={arrow} />
          </a>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-[2.75rem] xl:text-[3.25rem] lg:leading-[1.1] font-bold tracking-tight text-white mb-6 animate-fade-up animate-delay-1">
            The multiplayer framework
            <br />
            <span class="gradient-text">developers love</span>
          </h1>
          <p class="text-lg lg:text-xl text-gray-300 max-w-xl mx-auto lg:mx-0 mb-8 animate-fade-up animate-delay-2">
            Open-source, battle-tested, and built for real-time games. Free forever.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start items-center mb-6 animate-fade-up animate-delay-3">
            <a href={DOCS_URL} class="fw-cta-primary relative inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold whitespace-nowrap overflow-hidden" data-track="framework_cta" data-track-target="docs" data-track-placement="hero">
              Get started
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={arrow} />
            </a>
            <a href={GITHUB_URL} class="inline-flex items-center gap-2.5 px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 hover:bg-white/5 text-white font-medium transition-all" data-track="framework_cta" data-track-target="github" data-track-placement="hero">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
              Star on GitHub
              {stars && <span class="text-xs text-gray-400 border-l border-white/10 pl-2.5">{stars}</span>}
            </a>
          </div>

          <div class="flex items-center w-full max-w-md mx-auto lg:mx-0 bg-white/[0.03] border border-white/10 rounded-lg pl-4 pr-2 py-1.5 animate-fade-up animate-delay-3">
            <span class="text-gray-600 mr-3 select-none font-mono">$</span>
            <code class="font-mono text-[13px] sm:text-sm text-gray-300 flex-1 text-left whitespace-nowrap overflow-x-auto">{CREATE_COMMAND}</code>
            <button type="button" class="relative p-2 rounded-lg hover:bg-white/5 text-gray-500 hover:text-gray-300 transition-colors shrink-0" data-copy-text={CREATE_COMMAND} aria-label="Copy the create command" data-track="framework_cta" data-track-target="copy_create" data-track-placement="hero">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span class="fw-copied-tip absolute pointer-events-none text-xs bg-white/10 text-white rounded py-1 px-2 -translate-x-1/2 left-1/2 top-full mt-1 whitespace-nowrap">Copied!</span>
            </button>
          </div>
          <p class="text-xs text-gray-600 mt-3">
            <a href="https://nodejs.org/en" class="hover:text-gray-400 transition-colors">Requires Node.js</a>
          </p>

          <div class="mt-10">
            <Platforms align="left" />
          </div>
        </div>

        <div class="mt-16 lg:mt-0 animate-fade-up animate-delay-3">
          <SyncDemo />
        </div>
      </div>

      <ul class="grid sm:grid-cols-2 xl:grid-cols-4 gap-px mt-20 lg:mt-24 rounded-2xl border border-white/10 bg-white/10 overflow-hidden">
        {highlights.map((h, i) => (
          <li class="flex items-center gap-3 px-5 py-4 bg-[#0e0c12]" data-reveal style={`--reveal-delay:${0.04 * i}s`}>
            <span class="shrink-0 w-9 h-9 rounded-lg bg-gradient-to-br from-purple-500/20 to-fuchsia-500/10 border border-purple-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={h.icon} />
            </span>
            <span class="text-gray-200 font-medium">{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ScrollCodeShowcase />

  <!-- ===== NETCODE (0.18) ===== -->
  <section id="netcode" class="relative border-t border-white/5 bg-section-glow-purple scroll-mt-16">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">New in 0.18</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">Netcode for <span class="gradient-text">fast-paced games</span></h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          The server stays authoritative and controls still feel instant. Colyseus runs the prediction, reconciliation and
          rewind loops. You write the step function once and share it between server and client.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] gap-10 lg:gap-14 items-start">
        <div class="relative" data-reveal="scale">
          <div class="absolute -inset-4 rounded-[1.75rem] bg-gradient-to-br from-purple-600/20 via-fuchsia-500/10 to-cyan-500/15 blur-2xl pointer-events-none"></div>
          <div class="relative rounded-2xl border border-white/10 bg-[#0d0d10] overflow-hidden shadow-2xl" data-code-tabs>
            <div class="flex items-center gap-1 px-2 pt-2 border-b border-white/5 bg-white/[0.03]" role="tablist">
              <button type="button" role="tab" aria-selected="true" class="fw-tab" data-tab="server">
                GameRoom.ts <span class="fw-tab-badge bg-purple-500/15 text-purple-300">Server</span>
              </button>
              <button type="button" role="tab" aria-selected="false" class="fw-tab" data-tab="client">
                client.ts <span class="fw-tab-badge bg-green-500/15 text-green-300">Client</span>
              </button>
            </div>
            <div class="homepage-code text-sm" role="tabpanel" data-panel="server"><Code code={netcodeServer} lang="ts" /></div>
            <div class="homepage-code text-sm" role="tabpanel" data-panel="client" hidden><Code code={netcodeClient} lang="ts" /></div>
          </div>
        </div>

        <div>
          <ul class="space-y-6">
            {netcodePoints.map((p, i) => (
              <li class="flex gap-4" data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                <span class="shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500/20 to-fuchsia-500/10 border border-purple-500/20 flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                </span>
                <div>
                  <h3 class="text-white font-semibold text-lg mb-1">{p.title}</h3>
                  <p class="text-gray-400 leading-relaxed">{p.body}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3" data-reveal>
            <a href="https://prediction-colyseus.vercel.app/" class="group inline-flex items-center gap-2 text-purple-300 hover:text-purple-200 font-medium transition-colors" data-track="framework_cta" data-track-target="prediction_playground" data-track-placement="netcode">
              Try the Prediction Playground <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
            </a>
            <a href="https://docs.colyseus.io/netcode" class="group inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium transition-colors" data-track="framework_cta" data-track-target="netcode_docs" data-track-placement="netcode">
              Netcode docs <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
          <p class="mt-3 text-sm text-gray-500" data-reveal>The playground is open source: twelve labs, each with a latency slider.</p>
        </div>
      </div>
    </div>
  </section>

  <SDKShowcase />

  <!-- ===== UNDER THE HOOD ===== -->
  <section id="stack" class="border-t border-white/5 scroll-mt-16">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">Under the hood</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">A solid stack, <span class="gradient-text">so you don't rebuild it</span></h2>
        <p class="text-gray-400 max-w-xl mx-auto">Focus on your game instead of re-inventing the networking, the rooms and the serialization.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-fw-spotlight>
        {stack.map((s, i) => (
          <a href={s.href} class="spotlight group flex flex-col p-6 lg:p-7 rounded-2xl border border-white/5 hover:border-white/10 bg-white/[0.02] transition-colors" data-reveal="scale" style={`--reveal-delay:${0.05 * (i % 3)}s`}>
            <div class="flex items-start justify-between mb-5">
              <span class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500/20 to-fuchsia-500/10 border border-purple-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </span>
              <svg class="w-4 h-4 text-gray-600 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={arrow} />
            </div>
            <h3 class="text-white font-semibold text-lg mb-2">{s.title}</h3>
            <p class="text-gray-400 leading-relaxed">{s.body}</p>
          </a>
        ))}
      </div>

      <p class="mt-10 text-center" data-reveal>
        <a href="https://docs.colyseus.io/learn" class="group inline-flex items-center gap-2 text-purple-300 hover:text-purple-200 font-medium transition-colors" data-track="framework_cta" data-track-target="learn" data-track-placement="stack">
          Learn Colyseus <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ===== SCALABILITY ===== -->
  <section id="scalability" class="border-t border-white/5 bg-section-glow-blue scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-12 lg:gap-16 items-center">
      <div data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">Scale with confidence</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-5">From one process <span class="gradient-text">to a cluster</span></h2>
        <p class="text-gray-400 leading-relaxed mb-6">
          A simple yet powerful scaling strategy. Add processes and machines behind a load balancer, share a Redis, and
          matchmaking works across all of them.
        </p>
        <ul class="space-y-3 mb-8">
          {scaling.map((s) => (
            <li class="flex items-start gap-3 text-gray-300">
              <svg class="w-4 h-4 mt-1 text-purple-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
              <span set:html={s} />
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <a href="https://docs.colyseus.io/scalability" class="group inline-flex items-center gap-2 text-purple-300 hover:text-purple-200 font-medium transition-colors" data-track="framework_cta" data-track-target="scalability_docs" data-track-placement="scalability">
            Read the scalability guide <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="/cloud-managed-hosting" class="group inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium transition-colors" data-track="framework_cta" data-track-target="cloud" data-track-placement="scalability">
            Or let Colyseus Cloud scale it <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>

      <figure data-reveal="scale">
        <div class="rounded-2xl border border-white/10 bg-[#0d0d10] p-4 sm:p-6 shadow-2xl">
          <ScaleDiagram />
        </div>
        <figcaption class="mt-4 grid gap-1.5 text-sm text-gray-500">
          <span><span class="fw-step">1</span><code class="text-gray-400">joinOrCreate()</code> asks any process for a seat, through the load balancer.</span>
          <span><span class="fw-step">2</span>The processes agree through Redis where the room lives, and reserve the seat.</span>
          <span><span class="fw-step fw-step-green">3</span>The client connects straight to that process over WebSocket.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== TOOLING ===== -->
  <section id="ecosystem" class="border-t border-white/5 scroll-mt-16">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">Developer experience</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">Tools from first line <span class="gradient-text">to production</span></h2>
        <p class="text-gray-400 max-w-xl mx-auto">Built-in tools that accompany you from development to production.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-fw-spotlight>
        {tools.map((t, i) => (
          <a href={t.href} class="spotlight group flex gap-4 p-6 rounded-2xl border border-white/5 hover:border-white/10 bg-white/[0.02] transition-colors" data-reveal="scale" style={`--reveal-delay:${0.05 * (i % 3)}s`}>
            <span class="shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500/20 to-fuchsia-500/10 border border-purple-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
            </span>
            <div class="min-w-0">
              <h3 class="flex items-center gap-2 text-white font-semibold mb-1.5">
                {t.title}
                {t.badge && <span class="text-[10px] font-medium uppercase tracking-wide px-1.5 py-0.5 rounded border bg-amber-500/15 text-amber-300 border-amber-500/30">{t.badge}</span>}
              </h3>
              <p class="text-sm text-gray-400 leading-relaxed">{t.body}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-20 text-center" data-reveal>
        <h3 class="text-2xl lg:text-3xl font-bold text-white">Bring your Node.js stack</h3>
        <p class="mt-2 text-gray-400">Any npm package works in your rooms and routes.</p>
        <ul class="mt-10 flex flex-wrap justify-center items-center gap-x-12 gap-y-8">
          {ecosystem.map((e) => (
            <li>
              <a href={e.href} class="block opacity-40 hover:opacity-80 transition-opacity" title={e.name}>
                <Image src={e.logo} alt={e.name} class="w-24 lg:w-32 brightness-0 invert" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <SponsorsSection />

  <!-- ===== FINAL CTA ===== -->
  <section class="relative border-t border-white/5 overflow-hidden">
    <Aurora tone="framework" soft blobs={[1, 3]} />
    <div class="relative max-w-4xl mx-auto px-6 py-24 lg:py-32 text-center" data-reveal>
      <h2 class="font-display text-3xl lg:text-5xl font-bold text-white mb-5">Start your <span class="gradient-text">multiplayer game</span></h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-8">Scaffold a server in seconds, connect your engine, and deploy when you're ready.</p>

      <div class="flex items-center w-full max-w-md mx-auto bg-white/[0.03] border border-white/10 rounded-lg pl-4 pr-2 py-1.5 mb-8">
        <span class="text-gray-600 mr-3 select-none font-mono">$</span>
        <code class="font-mono text-[13px] sm:text-sm text-gray-300 flex-1 text-left whitespace-nowrap overflow-x-auto">{CREATE_COMMAND}</code>
        <button type="button" class="relative p-2 rounded-lg hover:bg-white/5 text-gray-500 hover:text-gray-300 transition-colors shrink-0" data-copy-text={CREATE_COMMAND} aria-label="Copy the create command" data-track="framework_cta" data-track-target="copy_create" data-track-placement="final">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span class="fw-copied-tip absolute pointer-events-none text-xs bg-white/10 text-white rounded py-1 px-2 -translate-x-1/2 left-1/2 top-full mt-1 whitespace-nowrap">Copied!</span>
        </button>
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href={DOCS_URL} class="fw-cta-primary relative inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold overflow-hidden" data-track="framework_cta" data-track-target="docs" data-track-placement="final">
          Get started
        </a>
        <a href={discordUrl} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 hover:bg-white/5 text-white font-medium transition-all" data-track="framework_cta" data-track-target="discord" data-track-placement="final">
          Join the Discord
        </a>
        <a href="/cloud-managed-hosting" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-gray-400 hover:text-white font-medium transition-colors" data-track="framework_cta" data-track-target="cloud" data-track-placement="final">Deploy on Colyseus Cloud →</a>
      </div>

      <p class="mt-12 text-sm text-gray-500 max-w-lg mx-auto">
        Colyseus is independent and MIT-licensed. <a href="/cloud-managed-hosting" class="text-gray-400 hover:text-white">Colyseus Cloud</a>
        subscriptions and sponsors keep it going. If you use it and don't use Cloud,
        <a href={SUPPORTERS_ENTRY_URL} class="text-purple-300 hover:text-purple-200" data-track="framework_cta" data-track-target="sponsor" data-track-placement="final">consider sponsoring</a>.
      </p>
    </div>
  </section>
</MainLayout>

<style is:global>
  .fw-cta-primary {
    background: linear-gradient(135deg, #6d28d9, #9333ea 50%, #c026d3);
    box-shadow: 0 10px 30px -10px rgba(147, 51, 234, 0.75);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .fw-cta-primary:hover { box-shadow: 0 14px 40px -10px rgba(147, 51, 234, 0.95); transform: translateY(-1px); }
  .fw-cta-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
    transform: translateX(-120%);
  }
  @keyframes fw-sheen { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  @media (prefers-reduced-motion: no-preference) {
    .fw-cta-primary::after { animation: fw-sheen 4.5s ease-in-out infinite; }
  }

  .fw-copied-tip { opacity: 0; transition: opacity 0.2s ease; }
  [data-copied="yes"] > .fw-copied-tip { opacity: 1; }

  .fw-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem 0.5rem 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    color: rgb(107, 114, 128);
    border: 1px solid transparent;
    border-bottom: 0;
    margin-bottom: -1px;
    transition: color 0.2s ease;
  }
  .fw-tab:hover { color: rgb(209, 213, 219); }
  .fw-tab[aria-selected="true"] { color: #fff; background: #0d0d10; border-color: rgba(255, 255, 255, 0.05); }
  /* .homepage-code sets display, which beats the [hidden] attribute. */
  [data-code-tabs] [hidden] { display: none; }
  .fw-tab-badge { font-family: Inter, sans-serif; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.0625rem 0.375rem; border-radius: 9999px; }

  .fw-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin-right: 0.5rem;
    border-radius: 9999px;
    font-size: 10px;
    font-weight: 700;
    color: #e9d5ff;
    background: #2a1840;
    border: 1px solid rgba(168, 85, 247, 0.5);
    vertical-align: 1px;
  }
  .fw-step-green { color: #bbf7d0; background: #10291a; border-color: rgba(74, 222, 128, 0.6); }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-copy-text]').forEach(function (btn) {
      var t = null;
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy-text');
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text);
        btn.setAttribute('data-copied', 'yes');
        clearTimeout(t);
        t = setTimeout(function () { btn.setAttribute('data-copied', 'no'); }, 1200);
      });
    });

    document.querySelectorAll('[data-fw-spotlight] .spotlight').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });

    document.querySelectorAll('[data-code-tabs]').forEach(function (box) {
      var tabs = box.querySelectorAll('[data-tab]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.setAttribute('aria-selected', String(t === tab)); });
          box.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== tab.getAttribute('data-tab'); });
        });
      });
    });
  })();
</script>
