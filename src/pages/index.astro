---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';

import { collections } from '../content/config';

import Aurora from '../components/Aurora.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SponsorsSection from '../components/SponsorsSection.astro';
import SuccessStoriesSection from '../components/SuccessStoriesSection.astro';
import JoinCommunitySection from '../components/JoinCommunitySection.astro';
import Platforms from '../components/Platforms.astro';
import HomepageCodeShowcase from '../components/HomepageCodeShowcase.astro';
import RoomCode from '../content/framework/code-server-room.mdx';

import { platforms, sdks } from '../data/sdks';
import { SOCIAL_LINKS } from '../data/navigation';
import { ONE_PROMPT_RUN as run, hasOnePromptRun } from '../data/ai-poc';
import { githubStars } from '../indexes/stats';
import panelOverview from '../../assets/cloud/panel/overview.webp';

const CREATE_COMMAND = "npm create colyseus-app@latest ./my-server";
const DOCS_URL = "https://docs.colyseus.io/getting-started";
const GITHUB_URL = "https://github.com/colyseus/colyseus";
const REEL_URL = "https://www.youtube.com/watch?v=3EEw5Sl93KE";
const FOUNDER_CALL_URL = "https://calendly.com/endel/intro";
const discordUrl = SOCIAL_LINKS.find((l) => l.label === "Discord")!.href;
// The GitHub API can rate-limit the build; drop the count rather than show "NaN".
const stars = typeof githubStars === "number" ? `${(githubStars / 1000).toFixed(1)}k` : null;

const description = "Colyseus is the open-source multiplayer framework for Node.js: matchmaking, state sync, client-side prediction, and SDKs for Unity, Godot, Defold and the web.";

const teams = [
  { name: "PreAlpha", href: "https://prealpha.dev/", logo: "/images/teams/prealpha.svg" },
  { name: "Bloxd.io", href: "https://bloxd.io/", logo: "/images/teams/bloxd.svg" },
  { name: "Pixels", href: "https://pixels.xyz/", logo: "/images/teams/pixels.png" },
  { name: "Emolingo", href: "https://emolingo.games/", logo: "/images/teams/emolingo.png" },
  { name: "One Way Block", href: "https://onewayblock.com/", logo: "/images/teams/owb-studio.webp" },
  { name: "DinoBros", href: "https://dinobros.com/", logo: "/images/teams/dinobros.svg" },
  { name: "Elanra Studios", href: "https://elanrastudios.com/", logo: "/images/teams/elanra-studios.webp" },
  { name: "Animoca Brands", href: "https://animocabrands.com/", logo: "/images/teams/animoca-brands.webp" },
];

// Full class names, so Tailwind keeps them.
const tones = {
  purple: { eyebrow: "text-purple-400", link: "text-purple-300 group-hover:text-purple-200", check: "text-purple-400", glow: "from-purple-500/20 to-fuchsia-500/5" },
  blue: { eyebrow: "text-blue-400", link: "text-blue-300 group-hover:text-blue-200", check: "text-blue-400", glow: "from-blue-500/20 to-cyan-500/5" },
  ai: { eyebrow: "text-cyan-400", link: "text-cyan-300 group-hover:text-cyan-200", check: "text-cyan-400", glow: "from-cyan-500/20 to-pink-500/5" },
};

const pillars = [
  {
    key: "framework",
    tone: tones.purple,
    eyebrow: "Framework",
    title: "Write the game, not the netcode",
    body: "Rooms, matchmaking, delta state sync and client-side prediction in one open-source Node.js framework.",
    points: ["MIT licensed", "TypeScript end to end", `${sdks.length} client SDKs`],
    href: "/framework/",
    cta: "Explore the framework",
  },
  {
    key: "cloud",
    tone: tones.blue,
    eyebrow: "Colyseus Cloud",
    title: "Deploy and scale without DevOps",
    body: "One command takes your server to production in any of 32 locations, and every update ships with zero downtime.",
    points: ["From $15/mo", "No CCU limits", "99.9% uptime SLA"],
    href: "/cloud-managed-hosting/",
    cta: "Explore Colyseus Cloud",
  },
  {
    key: "ai",
    tone: tones.ai,
    eyebrow: "Colyseus for AI",
    title: "One prompt, a real multiplayer game",
    body: "An agent skill and a scaffold that never asks questions let Claude Code, Cursor or Codex build and test a Colyseus game on their own.",
    points: hasOnePromptRun
      ? ["1 prompt", `${run.humanEdits} hand edits`, `${run.durationMin} min, prompt to commit`]
      : ["Agent skill", "llms.txt docs", "Typed server to client"],
    href: "/ai/",
    cta: "Get the prompt",
  },
];

const features = [
  {
    title: "Authoritative state sync",
    body: "Define your state once on the server. Colyseus sends each client only the fields that changed, as binary patches, and clients can't tamper with it.",
    href: "https://docs.colyseus.io/state",
    icon: `<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/>`,
  },
  {
    title: "Built-in matchmaking",
    body: "Rooms spawn on demand and fill by the filters you set. Lobbies, ranked queues, private and password-protected rooms are included.",
    href: "https://docs.colyseus.io/matchmaker",
    icon: `<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/>`,
  },
  {
    title: "Prediction & lag compensation",
    badge: "New",
    body: "Your player moves on the next frame and reconciles when the server answers. Hit tests rewind to what each shooter saw.",
    href: "https://docs.colyseus.io/netcode",
    icon: `<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>`,
  },
  {
    title: "Scales with your game",
    body: "From 10 to 10,000+ CCU. Spread rooms across processes and machines, with matchmaking working across all of them.",
    href: "https://docs.colyseus.io/scalability",
    icon: `<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/>`,
  },
  {
    title: "SDKs for every engine",
    body: "Unity, Godot, Defold, GameMaker, Construct 3, Haxe, React and plain TypeScript. State sync works the same in all of them.",
    href: "https://docs.colyseus.io/sdk",
    icon: `<rect x="2" y="7" width="20" height="11" rx="5.5"/><path d="M7 10.5v4M5 12.5h4M15.5 11.5h.01M18 13.5h.01"/>`,
  },
  {
    title: "Free & open source",
    body: "MIT licensed and free forever, commercial games included. You keep full control of your code and your infrastructure.",
    href: `${GITHUB_URL}/blob/master/LICENSE`,
    icon: `<path d="M12 21s-7-4.4-9.3-9A5 5 0 0 1 12 6a5 5 0 0 1 9.3 6c-2.3 4.6-9.3 9-9.3 9z"/>`,
  },
];

const hosting = [
  {
    title: "Standard Node.js",
    body: "No proprietary runtime. Your Colyseus server is a Node.js app, so every npm package and every tool you already use still works.",
    icon: `<path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M12 22V12M3 7l9 5 9-5"/>`,
  },
  {
    title: "Host anywhere",
    body: "AWS, Google Cloud, DigitalOcean, Fly.io, Railway or bare metal. If it runs Node.js, it runs Colyseus.",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>`,
  },
];

const comparisons = [
  { title: "vs Photon", items: ["Open-source, own your servers", "No CCU pricing surprises", "Full server-side control"] },
  { title: "vs Mirror", items: ["Works with any game engine", "Not tied to Unity", "Runs as a standalone server process"] },
  { title: "vs Nakama", items: ["Simpler API, faster to learn", "TypeScript-native", "Purpose-built for room-based multiplayer"] },
  { title: "vs From Scratch", items: ["Battle-tested in production", "Ship in days, not months", "Active community support"] },
];

const sdkNames = (tag: string) => sdks.filter((s) => s.tag === tag).map((s) => s.name).join(", ");

const faqs: FaqItem[] = [
  {
    q: "What is Colyseus?",
    a: "Colyseus is an open-source multiplayer framework for Node.js. You write authoritative game servers in TypeScript or JavaScript, and it handles rooms, matchmaking, real-time state synchronization and client-side prediction, with client SDKs for the major game engines.",
  },
  {
    q: "Is Colyseus free?",
    a: "Yes. The framework is MIT licensed and free forever, commercial games included. Colyseus Cloud is an optional paid hosting service, starting at $15 per month.",
  },
  {
    q: "Which game engines does Colyseus support?",
    a: `Stable SDKs: ${sdkNames("Stable")}. In alpha: ${sdkNames("Alpha")}. The server is always Node.js, and state synchronization works the same way in every SDK.`,
  },
  {
    q: "Do I have to host on Colyseus Cloud?",
    a: "No. A Colyseus server is a standard Node.js application, so it runs on any provider or on your own hardware. Colyseus Cloud is there when you'd rather not manage servers yourself.",
  },
  {
    q: "Can AI coding agents build games with Colyseus?",
    a: "Yes. Install the Colyseus agent skill with `npx skills add colyseus/skill` and agents like Claude Code, Cursor and Codex write against the current 0.18 API. The scaffold runs without interactive questions, and `@colyseus/testing` lets the agent check that two players really see each other.",
  },
];

const half = Math.ceil(collections.showcase.length / 2);
const showcaseRows = [
  { items: collections.showcase.slice(0, half), direction: 'marquee-left' },
  { items: collections.showcase.slice(half), direction: 'marquee-right' },
];

// Names the site in search results; Organization and SoftwareApplication come from BaseHead.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Colyseus",
  alternateName: "Colyseus Multiplayer Framework",
  url: new URL("/", Astro.site).href,
};

const arrow = `<path d="M5 12h14M12 5l7 7-7 7"/>`;
const check = `<path d="M20 6 9 17l-5-5"/>`;
---

<MainLayout title="Colyseus - Real-Time Multiplayer Framework for Node.js" description={description} isHeaderExpanded={false}>
  <ScrollReveal />
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />

  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden">
    <Aurora tone="home" grid />
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#0a0a0b] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-16 lg:pt-36 lg:pb-24">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14 lg:items-center">
        <div class="text-center lg:text-left">
          <a href="/blog/colyseus-018-is-here/" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-400/30 bg-purple-400/10 text-purple-200 text-sm font-medium hover:bg-purple-400/20 hover:border-purple-400/40 transition-all mb-6 animate-fade-up" data-track="home_cta" data-track-target="release" data-track-placement="hero_badge">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-300"></span>
            <span class="sm:hidden">New: Colyseus 0.18</span>
            <span class="hidden sm:inline">Colyseus 0.18: client-side prediction &amp; lag compensation</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={arrow} />
          </a>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-[2.75rem] xl:text-[3.25rem] lg:leading-[1.1] font-bold tracking-tight text-white mb-5 animate-fade-up animate-delay-1">
            <span class="block font-sans text-sm font-medium uppercase tracking-widest text-purple-300 mb-4">Open-source multiplayer framework for Node.js</span>
            Ship multiplayer
            <br />
            <span id="typewriter" class="text-purple-300">Games</span>
            <br />
            <span class="gradient-text">faster</span>
          </h1>

          <p class="text-lg text-gray-300 max-w-xl mx-auto lg:mx-0 mb-7 animate-fade-up animate-delay-2">
            Matchmaking, state sync and client-side prediction built in, with SDKs for Unity, Godot, Defold and the web.
          </p>

          <div class="flex flex-col xl:flex-row gap-3 justify-center lg:justify-start items-center lg:items-start xl:items-stretch animate-fade-up animate-delay-3">
            <a href={DOCS_URL} class="home-cta-primary relative inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold whitespace-nowrap overflow-hidden" data-track="home_cta" data-track-target="docs" data-track-placement="hero">
              Get started
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={arrow} />
            </a>
            <div class="flex items-center w-full max-w-md xl:w-auto xl:flex-1 min-w-0 bg-white/[0.03] border border-white/10 rounded-lg pl-4 pr-2 py-1.5">
              <span class="text-gray-600 mr-3 select-none font-mono">$</span>
              <code class="font-mono text-[13px] text-gray-300 flex-1 text-left whitespace-nowrap overflow-x-auto">{CREATE_COMMAND}</code>
              <button type="button" class="relative p-2 rounded-lg hover:bg-white/5 text-gray-500 hover:text-gray-300 transition-colors shrink-0" data-copy-text={CREATE_COMMAND} aria-label="Copy the create command" data-track="home_cta" data-track-target="copy_create" data-track-placement="hero">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="home-copied-tip absolute pointer-events-none text-xs bg-white/10 text-white rounded py-1 px-2 -translate-x-1/2 left-1/2 top-full mt-1 whitespace-nowrap">Copied!</span>
              </button>
            </div>
          </div>
          <a href={GITHUB_URL} class="inline-flex items-center gap-2 mt-4 text-sm text-gray-500 hover:text-gray-300 transition-colors animate-fade-up animate-delay-3" data-track="home_cta" data-track-target="github" data-track-placement="hero">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
            {stars ? `${stars} stars on GitHub` : "Star on GitHub"} · MIT licensed
          </a>

          <div class="mt-8">
            <Platforms align="left" compact />
          </div>
        </div>

        <!-- Gameplay reel from shipped games -->
        <figure class="relative mt-20 lg:mt-0 animate-fade-up animate-delay-3">
          <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-violet-600/25 via-indigo-500/10 to-blue-500/20 blur-2xl pointer-events-none" aria-hidden="true"></div>
          <div class="relative rounded-2xl border border-white/10 bg-[#0d0d10] overflow-hidden shadow-2xl shadow-purple-500/10">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-white/[0.03]">
              <div class="flex gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-[#ff5f57]/70"></span>
                <span class="w-3 h-3 rounded-full bg-[#febc2e]/70"></span>
                <span class="w-3 h-3 rounded-full bg-[#28c840]/70"></span>
              </div>
              <span class="mx-auto px-3 py-0.5 rounded-md bg-white/5 text-[11px] text-gray-500 font-mono truncate min-w-0">shipped with Colyseus</span>
            </div>
            <video class="block w-full h-auto" width="960" height="540" muted loop playsinline preload="none" poster="/images/background/video-poster.webp" data-home-reel aria-label="Gameplay from multiplayer games built with Colyseus">
              <source src="/images/background/video-360.mp4" type="video/mp4" media="(max-width: 767px)" />
              <source src="/images/background/video.mp4" type="video/mp4" />
            </video>
          </div>
          <figcaption class="relative mt-4 text-center text-sm">
            <a href={REEL_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gray-500 hover:text-purple-300 transition-colors" data-track="home_cta" data-track-target="reel" data-track-placement="hero">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              Watch the Colyseus reel
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== SOCIAL PROOF BAR ===== -->
  <section class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 py-10">
      <p class="text-center text-xs uppercase tracking-widest text-gray-500 mb-8">Trusted by teams with millions of players</p>
      <div class="home-marquee overflow-hidden relative">
        <div class="absolute inset-y-0 left-0 w-24 lg:w-40 bg-gradient-to-r from-[#0a0a0b] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-24 lg:w-40 bg-gradient-to-l from-[#0a0a0b] to-transparent z-10 pointer-events-none"></div>
        <div class="flex w-max marquee-teams">
          {[false, true].map((duplicate) => (
            <div class="flex items-center gap-12 lg:gap-16 shrink-0 pr-12 lg:pr-16" aria-hidden={duplicate || undefined}>
              {teams.map((team) => (
                <a href={team.href} target="_blank" rel="noopener noreferrer nofollow" tabindex={duplicate ? -1 : undefined} class="shrink-0 w-24 h-8 lg:w-32 lg:h-10 flex items-center justify-center opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300">
                  <img src={team.logo} alt={team.name} class="max-w-full max-h-full object-contain" loading="lazy" />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== THE THREE PRODUCTS ===== -->
  <section class="border-t border-white/5 bg-section-glow-purple">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">One stack</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">From first prototype <span class="gradient-text">to live game</span></h2>
        <p class="text-gray-400 max-w-2xl mx-auto">Build your server with the framework, let your coding agent write it with you, and take it live on Colyseus Cloud when players show up.</p>
      </div>

      <div class="grid lg:grid-cols-3 gap-5" data-home-spotlight>
        {pillars.map((p, i) => (
          <a href={p.href} class="spotlight group flex flex-col rounded-2xl border border-white/5 hover:border-white/10 bg-white/[0.02] overflow-hidden transition-colors" data-reveal="scale" style={`--reveal-delay:${0.06 * i}s`} data-track="home_cta" data-track-target={p.key} data-track-placement="pillars">
            <div class="p-6 lg:p-8">
              <p class={`flex items-center gap-2 h-5 text-sm font-medium uppercase tracking-widest mb-4 ${p.tone.eyebrow}`}>
                {p.key === "ai" && <span class="nav-ai-dot" aria-hidden="true"></span>}
                {p.eyebrow}
              </p>
              <h3 class="text-xl lg:text-2xl font-semibold text-white mb-2">{p.title}</h3>
              <p class="text-gray-400 leading-relaxed mb-4">{p.body}</p>
              <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-gray-400 mb-5">
                {p.points.map((point) => (
                  <li class="inline-flex items-center gap-1.5">
                    <svg class={`w-3.5 h-3.5 shrink-0 ${p.tone.check}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
                    {point}
                  </li>
                ))}
              </ul>
              <span class={`inline-flex items-center gap-2 font-medium transition-colors ${p.tone.link}`}>
                {p.cta} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </div>
            <!-- A preview peeks up from the bottom edge and rises on hover. -->
            <div class="relative mt-auto px-6 lg:px-8">
              <div class={`absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t ${p.tone.glow} pointer-events-none`} aria-hidden="true"></div>
              <div class="home-shot relative rounded-t-xl border border-b-0 border-white/10 overflow-hidden h-48 lg:h-56 bg-[#0d0d10]">
                {p.key === "framework" && <div class="homepage-code text-xs" aria-hidden="true"><RoomCode /></div>}
                {p.key === "cloud" && <Image src={panelOverview} alt="Colyseus Cloud panel: one application running in three regions" widths={[480, 800]} sizes="(min-width: 1024px) 30vw, 100vw" class="w-full h-full object-cover object-left-top" />}
                {p.key === "ai" && <img src={run.video.mobile.poster} alt={`${run.gameName}, a multiplayer game an AI agent built from one prompt`} width={run.video.mobile.width} height={run.video.mobile.height} loading="lazy" decoding="async" class="w-full h-full object-cover" />}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CODE EXAMPLE ===== -->
  <HomepageCodeShowcase />

  <!-- ===== FEATURES GRID ===== -->
  <section class="border-t border-white/5 bg-section-glow-purple">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-purple-400 uppercase tracking-widest mb-4">Why Colyseus</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">Everything you need <span class="gradient-text">for multiplayer</span></h2>
        <p class="text-gray-400 max-w-xl mx-auto">The parts every online game needs, already built and tested in production.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-home-spotlight>
        {features.map((f, i) => (
