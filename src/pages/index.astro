<style is:global>
  .home-cta-primary {
    background: linear-gradient(135deg, #6d28d9, #9333ea 50%, #c026d3);
    box-shadow: 0 10px 30px -10px rgba(147, 51, 234, 0.75);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .home-cta-primary:hover { box-shadow: 0 14px 40px -10px rgba(147, 51, 234, 0.95); transform: translateY(-1px); }
  .home-cta-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
    transform: translateX(-120%);
  }
  @keyframes home-sheen { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  @media (prefers-reduced-motion: no-preference) {
    .home-cta-primary::after { animation: home-sheen 4.5s ease-in-out infinite; }
  }

  .home-copied-tip { opacity: 0; transition: opacity 0.2s ease; }
  [data-copied="yes"] > .home-copied-tip { opacity: 1; }

  .home-shot { transform: translateY(8px); transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .group:hover .home-shot { transform: none; }

  /* A moving target is hard to click. */
  .home-marquee:hover .marquee-teams,
  .home-marquee:hover .marquee-left,
  .home-marquee:hover .marquee-right { animation-play-state: paused; }
</style>

<script is:inline>
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-copy-text]').forEach(function (btn) {
      var t = null;
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy-text');
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text);
        btn.setAttribute('data-copied', 'yes');
        clearTimeout(t);
        t = setTimeout(function () { btn.setAttribute('data-copied', 'no'); }, 1200);
      });
    });

    document.querySelectorAll('[data-home-spotlight] .spotlight').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });

    // The reel downloads only once it's on screen.
    var reel = document.querySelector('[data-home-reel]');
    if (reel) {
      var saveData = navigator.connection && navigator.connection.saveData;
      if (reduceMotion || saveData || !('IntersectionObserver' in window)) reel.setAttribute('controls', '');
      else new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return reel.pause();
        var p = reel.play();
        if (p && p.catch) p.catch(function () { reel.setAttribute('controls', ''); });
      }, { threshold: 0.25 }).observe(reel);
    }

    var tw = document.getElementById('typewriter');
    if (!tw || reduceMotion) return;
    var words = ['Games', 'Experiences', 'Apps', 'Worlds', 'Prototypes'];
    var wordIndex = 0, charIndex = words[0].length, isDeleting = true;

    function tick() {
      var current = words[wordIndex];
      charIndex += isDeleting ? -1 : 1;
      tw.textContent = current.substring(0, charIndex);
      if (!isDeleting && charIndex === current.length) { isDeleting = true; return setTimeout(tick, 2000); }
      if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        return setTimeout(tick, 400);
      }
      setTimeout(tick, isDeleting ? 50 : 80);
    }
    setTimeout(tick, 2000);
  })();
</script>
