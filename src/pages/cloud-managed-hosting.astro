---
import { Image } from "astro:assets";
import { Code } from "astro-expressive-code/components";
import MainLayout from "../layouts/MainLayout.astro";
import Aurora from "../components/Aurora.astro";
import Faq, { type FaqItem } from "../components/Faq.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import SimulatePriceComponent from "../components/SimulatePriceComponent";
// Shot from the panel's fixture preview (cloud/admin: vite.preview.config.ts), dark theme, 2x.
import panelOverview from "../../assets/cloud/panel/overview.webp";
import panelLogs from "../../assets/cloud/panel/logs.webp";
import panelLocations from "../../assets/cloud/panel/locations.webp";
import panelAlerts from "../../assets/cloud/panel/alerts.webp";
import panelStats from "../../assets/cloud/panel/stats.webp";
import panelDeploying from "../../assets/cloud/panel/deploying.webp";
import tunnelImage from "../../assets/blog/tunnel.webp";

const SIGNUP_URL = "https://cloud.colyseus.io/";
const FOUNDER_CALL_URL = "https://calendly.com/endel/intro";
const DEPLOY_COMMAND = "npx @colyseus/cloud deploy";

const highlights = [
  { label: "Deployments from CLI", icon: `<path d="m4 17 6-6-6-6M12 19h8"/>` },
  { label: "Predictable and affordable pricing", icon: `<circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.5-1-1.6-1.5-3-1.5-1.7 0-3 .9-3 2s1.3 1.7 3 2 3 .9 3 2-1.3 2-3 2c-1.4 0-2.5-.5-3-1.5M12 6v2m0 8v2"/>` },
  { label: "Scale horizontally or vertically", icon: `<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>` },
  { label: "No imposed CCU/DAU/MAU limits", icon: `<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/>` },
  { label: "Managed SSL Certificates", icon: `<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>` },
  { label: "32 locations available worldwide", icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>` },
  { label: "99.9% uptime SLA", icon: `<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/>` },
  { label: "Zero-downtime deployments", icon: `<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>` },
];

const check = `<path d="M20 6 9 17l-5-5"/>`;

const features = [
  {
    title: "32 global locations",
    body: "Get your servers close to your players. Add regions in one click: each location gets its own endpoint, ready to accept connections.",
    points: ["New regions without redeploying", "Lower latency worldwide", "One HTTP endpoint per location"],
    image: panelLocations,
    alt: "Choosing regions and plans for a new application, with its monthly price",
    icon: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>`,
  },
  {
    title: "Monitoring & alerting",
    body: "Hear about trouble before your players do. Alerts on CPU, memory, crashes and deploys go straight to Slack, Discord or email.",
    points: ["Slack, Discord or email", "CPU and memory thresholds", "Crashes, restarts and failed deploys"],
    image: panelAlerts,
    alt: "Alert settings: email, Slack or Discord, CPU and memory thresholds, application and deploy events",
    icon: `<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>`,
  },
  {
    title: "Real-time analytics",
    body: "See what your servers are doing. Track concurrent users, active rooms and resource usage, and scale before you need to.",
    points: ["Live CCU and room graphs", "CPU and memory per server", "Filter by region"],
    image: panelStats,
    alt: "Players online, rooms, CPU and memory charts across three regions over 24 hours",
    icon: `<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>`,
  },
  {
    title: "Zero-downtime deployments",
    body: "Ship updates without kicking players out. Old processes drain their rooms while new ones take every new connection on the latest version.",
    points: ["Active matches finish undisturbed", "New rooms on the new version", "Live output from every server"],
    image: panelDeploying,
    alt: "A deploy rolling out to two regions, with live output from each server",
    icon: `<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>`,
  },
];

const steps = [
  { title: "Create a Colyseus app", code: `npm create colyseus-app ./my-colyseus-server\ncd ./my-colyseus-server` },
  { title: "Push it to a Git repository", code: `git remote add origin <your-repo-url>\ngit add .\ngit push origin main` },
  { title: "Deploy it", code: `npm install @colyseus/cloud\nnpx @colyseus/cloud deploy` },
];

const faqs: FaqItem[] = [
  {
    q: "Does Colyseus Cloud offer a free tier?",
    a: "Not at the moment. The Colyseus framework itself is free and open source, so you can always host it on your own servers.",
  },
  {
    q: "What happens if I delete an application I've already paid for?",
    a: "Your account is credited with the unused time left on that application, and the credit goes towards your next one.",
  },
  {
    q: "Does Colyseus Cloud auto-scale?",
    a: "Not yet. For heavier workloads, upgrade your deployment's resources from the Colyseus Cloud dashboard. Auto-scaling for horizontally scaled (cluster) deployments is planned.",
  },
  {
    q: "How many CCU can Colyseus Cloud handle?",
    a: "It depends on your code: how much CPU it uses and how many messages your server and clients exchange. The pricing simulator includes a capacity estimate, but every game is different, so load-test yours to find its real limits.",
  },
  {
    q: "What's the difference between scaling vertically and horizontally?",
    a: "Scaling vertically gives a single server instance more CPU and memory. Scaling horizontally spreads your game across several instances that work as one cluster.",
  },
];
---

<MainLayout
  title="Colyseus Cloud - Managed Multiplayer Server Hosting"
  description="Deploy and scale multiplayer servers without DevOps. One-command deployments, zero-downtime updates, 32 global locations. Starting at $15/month."
  isHeaderExpanded={false}
  isBlue={true}
>
  <ScrollReveal />

  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden">
    <Aurora tone="cloud" grid />
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#0a0a0b] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-16 lg:pt-36 lg:pb-24">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14 lg:items-center">
        <div class="text-center lg:text-left">
          <a href="/blog/colyseus-tunnel/" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-blue-400/30 bg-blue-400/10 text-blue-200 text-sm font-medium hover:bg-blue-400/20 hover:border-blue-400/40 transition-all mb-6 animate-fade-up" data-track="cloud_cta" data-track-target="tunnel" data-track-placement="hero_badge">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-300"></span>
            <span class="sm:hidden">New: the Colyseus Tunnel</span>
            <span class="hidden sm:inline">New: share your local server with the Colyseus Tunnel</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-[2.75rem] xl:text-[3.25rem] lg:leading-[1.1] font-bold tracking-tight text-white mb-6 animate-fade-up animate-delay-1">
            Deploy and scale
            <br />
            <span class="gradient-text-blue">without DevOps</span>
          </h1>
          <p class="text-lg lg:text-xl text-gray-300 max-w-xl mx-auto lg:mx-0 mb-8 animate-fade-up animate-delay-2">
            The fastest way to get your Colyseus game server into production. Focus on your game, not infrastructure.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start items-center mb-6 animate-fade-up animate-delay-3">
            <a href={SIGNUP_URL} class="cloud-cta-primary relative inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold whitespace-nowrap overflow-hidden" data-track="cloud_cta" data-track-target="signup" data-track-placement="hero">
              Get started from $15/mo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#pricing" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 hover:bg-white/5 text-white font-medium transition-all" data-track="cloud_cta" data-track-target="pricing" data-track-placement="hero">
              Estimate your cost
            </a>
          </div>

          <div class="flex items-center w-full max-w-sm mx-auto lg:mx-0 bg-white/[0.03] border border-white/10 rounded-lg pl-4 pr-2 py-1.5 animate-fade-up animate-delay-3">
            <span class="text-gray-600 mr-3 select-none font-mono">$</span>
            <code class="font-mono text-sm text-gray-300 flex-1 text-left whitespace-nowrap">{DEPLOY_COMMAND}</code>
            <button type="button" class="relative p-2 rounded-lg hover:bg-white/5 text-gray-500 hover:text-gray-300 transition-colors" data-copy-text={DEPLOY_COMMAND} aria-label="Copy the deploy command" data-track="cloud_cta" data-track-target="copy_deploy" data-track-placement="hero">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span class="cloud-copied-tip absolute pointer-events-none text-xs bg-white/10 text-white rounded py-1 px-2 -translate-x-1/2 left-1/2 top-full mt-1 whitespace-nowrap">Copied!</span>
            </button>
          </div>
        </div>

        <!-- The panel, with its live logs floating over it -->
        <div class="relative mt-16 lg:mt-0 lg:mb-10 animate-fade-up animate-delay-3">
          <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-blue-600/25 via-cyan-500/10 to-indigo-500/25 blur-2xl pointer-events-none"></div>
          <div class="relative rounded-2xl border border-white/10 bg-[#0d0d10] overflow-hidden shadow-2xl shadow-blue-500/10">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-white/[0.03]">
              <div class="flex gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-[#ff5f57]/70"></span>
                <span class="w-3 h-3 rounded-full bg-[#febc2e]/70"></span>
                <span class="w-3 h-3 rounded-full bg-[#28c840]/70"></span>
              </div>
              <span class="mx-auto px-3 py-0.5 rounded-md bg-white/5 text-[11px] text-gray-500 font-mono">cloud.colyseus.io</span>
            </div>
            <Image src={panelOverview} alt="Colyseus Cloud panel: one application running in three regions, with players online, rooms, CPU and memory" widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 50vw, calc(100vw - 3rem)" class="block w-full h-auto" loading="eager" fetchpriority="high" />
          </div>
          <div class="hidden sm:block absolute -bottom-10 -left-6 lg:-left-10 w-[58%] rounded-xl overflow-hidden border border-white/10 shadow-2xl shadow-black/60 cloud-float">
            <Image src={panelLogs} alt="Live server logs in the Colyseus Cloud panel" widths={[480, 800]} sizes="30vw" class="block w-full h-auto" />
          </div>
        </div>
      </div>

      <ul class="grid sm:grid-cols-2 xl:grid-cols-4 gap-px mt-20 lg:mt-24 rounded-2xl border border-white/10 bg-white/10 overflow-hidden">
        {highlights.map((h, i) => (
          <li class="flex items-center gap-3 px-5 py-4 bg-[#0c0d12]" data-reveal style={`--reveal-delay:${0.04 * i}s`}>
            <span class="shrink-0 w-9 h-9 rounded-lg bg-gradient-to-br from-blue-500/20 to-cyan-500/10 border border-blue-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-blue-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={h.icon} />
            </span>
            <span class="text-gray-200 font-medium">{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section class="border-t border-white/5 bg-section-glow-blue">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-32">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-blue-400 uppercase tracking-widest mb-4">What you get</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">Production infrastructure, <span class="gradient-text-blue">handled</span></h2>
        <p class="text-gray-400 max-w-2xl mx-auto">Focus on building your multiplayer game or app. We run the servers, watch them and keep your players connected through every deploy.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-5" data-cloud-spotlight>
        {features.map((f, i) => (
          <article class="spotlight group flex flex-col rounded-2xl border border-white/5 hover:border-white/10 bg-white/[0.02] overflow-hidden transition-colors" data-reveal="scale" style={`--reveal-delay:${0.06 * (i % 2)}s`}>
            <div class="p-6 lg:p-8">
              <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500/20 to-cyan-500/10 border border-blue-500/20 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-blue-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </div>
              <h3 class="text-xl lg:text-2xl font-semibold text-white mb-2">{f.title}</h3>
              <p class="text-gray-400 leading-relaxed mb-4">{f.body}</p>
              <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-gray-400">
                {f.points.map((p) => (
                  <li class="inline-flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <!-- The screenshot peeks up from the bottom edge and rises on hover. -->
            <div class="mt-auto px-6 lg:px-8">
              <div class="cloud-shot rounded-t-xl border border-b-0 border-white/10 overflow-hidden h-52 lg:h-64 bg-[#0d0d10]">
                <Image src={f.image} alt={f.alt} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 45vw, calc(100vw - 6rem)" class="w-full h-full object-cover object-left-top" />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== DEPLOY IN THREE STEPS ===== -->
  <section class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-32">
      <div class="text-center mb-14" data-reveal>
        <p class="text-sm font-medium text-blue-400 uppercase tracking-widest mb-4">Get started</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">Three steps to production</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">From an empty folder to players connecting to your server. The scaffold already ships the configuration Colyseus Cloud reads.</p>
      </div>

      <ol class="relative grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="hidden lg:block absolute top-5 left-[16%] right-[16%] h-px bg-gradient-to-r from-blue-500/0 via-blue-500/40 to-blue-500/0" aria-hidden="true"></div>
        {steps.map((step, i) => (
          <li class="relative flex flex-col" data-reveal style={`--reveal-delay:${0.08 * i}s`}>
            <div class="flex lg:flex-col items-center gap-3 lg:gap-4 mb-4">
              <span class="relative z-10 w-10 h-10 shrink-0 rounded-full bg-[#0a0a0b] border border-blue-400/40 text-blue-200 font-semibold flex items-center justify-center shadow-[0_0_24px_-6px_rgba(59,130,246,0.7)]">{i + 1}</span>
              <h3 class="text-white font-semibold text-lg">{step.title}</h3>
            </div>
            <div class="homepage-code flex-1 rounded-xl border border-white/10 bg-[#0d0d10] text-sm">
              <Code code={step.code} lang="bash" />
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-10 text-center" data-reveal>
        <a href="https://docs.colyseus.io/cloud/" class="group inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 font-medium transition-colors" data-track="cloud_cta" data-track-target="docs" data-track-placement="steps">
          Read the deployment guide
          <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </p>

      <!-- Tunnel: the same login, before there's anything to deploy -->
      <div class="mt-16 grid lg:grid-cols-2 items-center gap-8 lg:gap-12 rounded-2xl border border-white/10 bg-white/[0.02] overflow-hidden" data-reveal="scale">
        <a href="/blog/colyseus-tunnel/" class="block" aria-label="Read: Share your localhost with the Colyseus Tunnel" data-track="cloud_cta" data-track-target="tunnel" data-track-placement="tunnel_image">
          <Image src={tunnelImage} alt="A public play.colyseus.dev URL forwarding to localhost:2567" widths={[640, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full h-full object-cover" />
        </a>
        <div class="p-6 pt-0 lg:p-10 lg:pl-0">
          <p class="text-sm font-medium text-purple-300 uppercase tracking-widest mb-3">Before you deploy</p>
          <h3 class="text-2xl lg:text-3xl font-bold text-white mb-3">Playtest from your machine</h3>
          <p class="text-gray-400 leading-relaxed mb-5">
            Your Colyseus Cloud login also opens the Colyseus Tunnel. It puts the game running on your machine on a
            public URL, so playtesters join from a link or a QR code. Free while it's in preview.
          </p>
          <div class="flex items-center bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 mb-5 font-mono text-sm text-gray-300 overflow-x-auto">
            <span class="text-gray-600 mr-3 select-none">$</span>npx colyseus-tunnel 2567
          </div>
          <a href="/blog/colyseus-tunnel/" class="group inline-flex items-center gap-2 text-purple-300 hover:text-purple-200 font-medium transition-colors" data-track="cloud_cta" data-track-target="tunnel" data-track-placement="tunnel_card">
            How the tunnel works
            <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" class="relative overflow-hidden border-t border-white/5 bg-section-glow-blue-bottom scroll-mt-16">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-32 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-10 lg:gap-16 items-center">
      <div data-reveal>
        <p class="text-sm font-medium text-blue-400 uppercase tracking-widest mb-4">Estimate your cost</p>
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-5">Pay for servers, <span class="gradient-text-blue">not players</span></h2>
        <p class="text-gray-400 leading-relaxed mb-6">
          Each location runs on a plan you pick, from $15/mo. There are no CCU, DAU or MAU limits and bandwidth is unlimited,
          so you only pay for the servers you run. Pick a location and a plan to see the price.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <a href="/pricing" class="group inline-flex items-center gap-2 text-blue-300 hover:text-blue-200 font-medium transition-colors" data-track="cloud_cta" data-track-target="pricing_page" data-track-placement="pricing">
            Compare plans <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href={FOUNDER_CALL_URL} class="group inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium transition-colors" data-track="cloud_cta" data-track-target="founder_call" data-track-placement="pricing">
            Need something custom? Talk to the founder <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>
      <div class="relative" data-reveal="scale">
        <div class="absolute -inset-4 rounded-[1.75rem] bg-gradient-to-br from-blue-600/20 via-cyan-500/10 to-indigo-500/20 blur-2xl pointer-events-none"></div>
        <div class="relative rounded-2xl border border-white/10 bg-[#0d0d10]/90 backdrop-blur p-6 lg:p-8 shadow-2xl">
          <SimulatePriceComponent title="" client:visible />
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="Colyseus Cloud questions" accent="blue">
    <p class="mt-6 text-center text-sm text-gray-500">
      Couldn't find your answer? <a href="mailto:support@colyseus.io?subject=Inquiry%2FQuestion%3A%20...&body=Hi" class="text-blue-300 hover:text-blue-200">Contact support</a>.
    </p>
  </Faq>

  <!-- ===== FINAL CTA ===== -->
  <section class="relative border-t border-white/5 overflow-hidden">
    <Aurora tone="cloud" soft blobs={[1, 3]} />
    <div class="relative max-w-4xl mx-auto px-6 py-24 lg:py-32 text-center" data-reveal>
      <h2 class="font-display text-3xl lg:text-5xl font-bold text-white mb-5">Take your game <span class="gradient-text-blue">live</span></h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-10">Deploy from your terminal, pick the locations closest to your players, and let Colyseus Cloud keep the servers running.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={SIGNUP_URL} class="cloud-cta-primary relative inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white font-semibold overflow-hidden" data-track="cloud_cta" data-track-target="signup" data-track-placement="final">
          Get started from $15/mo
        </a>
        <a href={FOUNDER_CALL_URL} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 hover:bg-white/5 text-white font-medium transition-all" data-track="cloud_cta" data-track-target="founder_call" data-track-placement="final">
          Speak with the founder
        </a>
        <a href="https://docs.colyseus.io/cloud/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-gray-400 hover:text-white font-medium transition-colors" data-track="cloud_cta" data-track-target="docs" data-track-placement="final">Read the docs →</a>
      </div>
    </div>
  </section>
</MainLayout>

<style is:global>
  .cloud-cta-primary {
    background: linear-gradient(135deg, #1d4ed8, #2563eb 45%, #0891b2);
    box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.75);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .cloud-cta-primary:hover { box-shadow: 0 14px 40px -10px rgba(37, 99, 235, 0.95); transform: translateY(-1px); }
  .cloud-cta-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
    transform: translateX(-120%);
  }
  @keyframes cloud-sheen { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }

  .cloud-shot { transform: translateY(8px); transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .group:hover .cloud-shot { transform: none; }

  @keyframes cloud-float { 50% { transform: translateY(-8px); } }

  @media (prefers-reduced-motion: no-preference) {
    .cloud-cta-primary::after { animation: cloud-sheen 4.5s ease-in-out infinite; }
    .cloud-float { animation: cloud-float 6s ease-in-out infinite; }
  }

  .cloud-copied-tip { opacity: 0; transition: opacity 0.2s ease; }
  [data-copied="yes"] > .cloud-copied-tip { opacity: 1; }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-copy-text]').forEach(function (btn) {
      var t = null;
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy-text');
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text);
        btn.setAttribute('data-copied', 'yes');
        clearTimeout(t);
        t = setTimeout(function () { btn.setAttribute('data-copied', 'no'); }, 1200);
      });
    });

    document.querySelectorAll('[data-cloud-spotlight] .spotlight').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  })();
</script>
